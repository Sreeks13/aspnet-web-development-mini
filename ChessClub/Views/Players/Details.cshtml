@model ChessClub.Models.Player

@{
    ViewData["Title"] = "Player Details";
}

<h1>Player Details</h1>

<div class="card">
    <div class="card-body">
        <h2>@Model.Name</h2>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Rating:</strong> @Model.Rating</p>
        <p><strong>Country:</strong> @Model.Country</p>

        <a asp-action="Index" class="btn btn-secondary">Back to Players</a>
    </div>
</div>
