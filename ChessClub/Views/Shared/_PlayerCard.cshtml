@model ChessClub.Models.Player

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text">
            <strong>Rating:</strong> @Model.Rating<br />
            <strong>Country:</strong> @Model.Country
        </p>
        <a asp-controller="Players"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            View Details
        </a>
    </div>
</div>
